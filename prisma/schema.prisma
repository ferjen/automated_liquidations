// Datasource: use PostgreSQL (e.g., Supabase) via DATABASE_URL
datasource db {
	provider = "postgresql"
	url      = env("DATABASE_URL")
}

generator client {
	provider = "prisma-client-js"
}

model Receipt {
	id                 String   @id @db.Uuid @default(dbgenerated("gen_random_uuid()"))
	createdAt          DateTime @default(now()) @map("created_at")
	businessName       String?  @map("business_name")
	location           String?
	tin                String?
	vat                Decimal? @db.Decimal(10, 2)
	vatExcl            Decimal? @db.Decimal(10, 2) @map("vat_excl")
	vatIncl            Decimal? @db.Decimal(10, 2) @map("vat_incl")
	pwdDiscountLabel   String?  @map("pwd_discount_label")
	pwdDiscountAmount  Decimal? @db.Decimal(10, 2) @map("pwd_discount_amount")

	@@map("receipts")
}


