# Copy this file to .env.local and fill in your actual values

# Database (Prisma)
# Example for local Postgres. For Supabase, paste the full connection URI here.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres?schema=public"

# Gemini AI (Required for receipt parsing and AI features)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Note: This project now uses Gemini AI Vision for receipt parsing instead of Google Cloud Vision
